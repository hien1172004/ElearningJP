### Variables
@baseUrl = http://localhost:8080/api/v1
@teacherToken = {{teacherLogin.response.body.data.accessToken}}
@studentToken = {{studentLogin.response.body.data.accessToken}}
@courseId = {{createCourseN5.response.body.data.id}}

### ============================================================
### 3.1) Tạo lesson THEORY (orderIndex=1)
### ============================================================
# @name createLesson1
POST {{baseUrl}}/courses/{{courseId}}/lessons
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "title": "Bài 1: Hiragana cơ bản",
  "lessonType": "THEORY",
  "orderIndex": 1,
  "durationMinutes": 30,
  "contentMarkdown": "# Hiragana\n\nHiragana gồm 46 ký tự..."
}

###
@lesson1Id = {{createLesson1.response.body.data.id}}

### ============================================================
### 3.2) Tạo lesson VOCABULARY (orderIndex=2)
### ============================================================
# @name createLesson2
POST {{baseUrl}}/courses/{{courseId}}/lessons
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "title": "Bài 2: Từ vựng chào hỏi",
  "lessonType": "VOCABULARY",
  "orderIndex": 2,
  "durationMinutes": 20,
  "contentMarkdown": "## あいさつ\n- おはよう: Chào buổi sáng"
}

###
@lesson2Id = {{createLesson2.response.body.data.id}}

### ============================================================
### 3.3) Tạo lesson MINI_TEST (orderIndex=3)
### ============================================================
# @name createLesson3
POST {{baseUrl}}/courses/{{courseId}}/lessons
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "title": "Bài 3: Mini Test",
  "lessonType": "MINI_TEST",
  "orderIndex": 3,
  "durationMinutes": 15,
  "contentMarkdown": "Bài kiểm tra 10 câu"
}

###
@lesson3Id = {{createLesson3.response.body.data.id}}

### ============================================================
### 3.4) (EXPECTED 409) Tạo lesson với orderIndex trùng
### ============================================================
POST {{baseUrl}}/courses/{{courseId}}/lessons
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "title": "Trùng order",
  "lessonType": "THEORY",
  "orderIndex": 1
}

### ============================================================
### 3.5) (EXPECTED 401) Student tạo lesson - không đủ quyền
### ============================================================
POST {{baseUrl}}/courses/{{courseId}}/lessons
Content-Type: application/json
Authorization: Bearer {{studentToken}}

{
  "title": "Student tạo lesson",
  "lessonType": "THEORY",
  "orderIndex": 99
}

### ============================================================
### 3.6) GET list lesson trong course (public - không contentMarkdown)
### ============================================================
GET {{baseUrl}}/courses/{{courseId}}/lessons

### ============================================================
### 3.7) GET lesson detail - Student chưa enroll → EXPECTED 403
### ============================================================
GET {{baseUrl}}/courses/{{courseId}}/lessons/{{lesson1Id}}
Authorization: Bearer {{studentToken}}

### ============================================================
### 3.8) Update lesson
### ============================================================
PUT {{baseUrl}}/courses/{{courseId}}/lessons/{{lesson1Id}}
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "durationMinutes": 45,
  "contentMarkdown": "Nội dung đã cập nhật"
}

### ============================================================
### 3.9) Reorder lessons
### ============================================================
POST {{baseUrl}}/courses/{{courseId}}/lessons/reorder
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "lessonIds": [{{lesson3Id}}, {{lesson1Id}}, {{lesson2Id}}]
}

### ============================================================
### 3.10) (EXPECTED 400) Reorder sai số lượng
### ============================================================
POST {{baseUrl}}/courses/{{courseId}}/lessons/reorder
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "lessonIds": [{{lesson1Id}}]
}

### ============================================================
### 3.11) Delete lesson
### ============================================================
DELETE {{baseUrl}}/courses/{{courseId}}/lessons/{{lesson3Id}}
Authorization: Bearer {{teacherToken}}

### ============================================================
### 3.12) (EXPECTED 404) GET lesson đã xóa
### ============================================================
GET {{baseUrl}}/courses/{{courseId}}/lessons/{{lesson3Id}}
