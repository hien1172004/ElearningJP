### ============================================================
### 7) LESSON ITEMS FLOW
###    - Test CRUD cho kanji items + related vocab
###    - Test CRUD cho vocabulary items + examples
###    - Test CRUD cho grammar items + examples
###    - Cần token giáo viên/admin
###    - Phải chạy 06 trước để có section (KANJI / VOCAB / GRAMMAR)
###
###  SAU REFACTOR (V14):
###    - Items (Kanji/Vocab/Grammar) chỉ thuộc về section tương ứng
###      (KANJI / VOCABULARY / GRAMMAR).
###    - Section TEST không dùng items ở đây mà dùng Quiz API
###      (xem LessonSectionQuizController).
### ============================================================

@baseUrl = http://localhost:8080/api/v1
@teacherToken = {{teacherLogin.response.body.data.accessToken}}
@studentToken = {{studentLogin.response.body.data.accessToken}}
@lessonId = {{createLessonTheory.response.body.data.id}}
@kanjiSectionId = {{createKanjiSection.response.body.data.id}}
@vocabSectionId = {{createVocabSection.response.body.data.id}}
@grammarSectionId = {{createGrammarSection.response.body.data.id}}


### ============================================================
### 7.1) KANJI SECTION — Items + Related Vocab
### ============================================================

### 7.1.1) Thêm 1 chữ Hán vào section KANJI
# @name addKanji1
POST {{baseUrl}}/lesson-sections/{{kanjiSectionId}}/kanji-items
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "characterId": 1,
  "orderIndex": 1,
  "note": "Chữ Hán 'học' - nghĩa: học tập"
}

###
@kanjiItem1Id = {{addKanji1.response.body.data.id}}


### 7.1.2) Thêm chữ Hán thứ 2
# @name addKanji2
POST {{baseUrl}}/lesson-sections/{{kanjiSectionId}}/kanji-items
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "characterId": 2,
  "note": "Chữ Hán 'sinh' - nghĩa: học sinh"
}

###
@kanjiItem2Id = {{addKanji2.response.body.data.id}}


### 7.1.3) Cập nhật chữ Hán 1 (đổi note)
PUT {{baseUrl}}/lesson-kanji-items/{{kanjiItem1Id}}
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "note": "Đã cập nhật: chữ Hán này cực kỳ quan trọng"
}


### 7.1.4) Thêm từ vựng liên quan cho chữ Hán 1
# @name addRelatedVocab1
POST {{baseUrl}}/lesson-kanji-items/{{kanjiItem1Id}}/related-vocabulary
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "vocabId": 1,
  "note": "Từ vựng chứa chữ Hán này"
}

###
@relatedVocab1Id = {{addRelatedVocab1.response.body.data.id}}


### 7.1.5) Xoá từ vựng liên quan
DELETE {{baseUrl}}/lesson-kanji-items/related-vocabulary/{{relatedVocab1Id}}
Authorization: Bearer {{teacherToken}}


### 7.1.6) (EXPECTED 400) Thêm kanji thiếu characterId
POST {{baseUrl}}/lesson-sections/{{kanjiSectionId}}/kanji-items
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "note": "Lỗi: thiếu characterId"
}


### 7.1.7) (EXPECTED 404) Thêm kanji với characterId không tồn tại
POST {{baseUrl}}/lesson-sections/{{kanjiSectionId}}/kanji-items
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "characterId": 999999
}


### 7.1.8) (EXPECTED 400) POST sai section type (section KANJI nhưng gọi endpoint vocabulary)
POST {{baseUrl}}/lesson-sections/{{kanjiSectionId}}/vocabulary-items
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "vocabId": 1
}


### 7.1.9) Xoá kanji item
DELETE {{baseUrl}}/lesson-kanji-items/{{kanjiItem2Id}}
Authorization: Bearer {{teacherToken}}


### ============================================================
### 7.2) VOCABULARY SECTION — Items + Examples
### ============================================================

### 7.2.1) Thêm 1 từ vựng vào section VOCABULARY
# @name addVocab1
POST {{baseUrl}}/lesson-sections/{{vocabSectionId}}/vocabulary-items
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "vocabId": 1,
  "orderIndex": 1,
  "customHiragana": "がくせい",
  "customMeaning": "học sinh (cho bài này)",
  "imageUrl": "https://example.com/student.jpg",
  "note": "Từ vựng đầu tiên"
}

###
@vocabItem1Id = {{addVocab1.response.body.data.id}}


### 7.2.2) Thêm ví dụ cho từ vựng
# @name addVocabExample1
POST {{baseUrl}}/lesson-vocabulary-items/{{vocabItem1Id}}/examples
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "exampleJp": "私は学生です。",
  "exampleVi": "Tôi là học sinh.",
  "exampleRomaji": "Watashi wa gakusei desu.",
  "isPrimary": true,
  "orderIndex": 1
}

###
@vocabExample1Id = {{addVocabExample1.response.body.data.id}}


### 7.2.3) Thêm ví dụ thứ 2 (không primary)
# @name addVocabExample2
POST {{baseUrl}}/lesson-vocabulary-items/{{vocabItem1Id}}/examples
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "exampleJp": "学生は勉強します。",
  "exampleVi": "Học sinh học bài.",
  "orderIndex": 2
}

###
@vocabExample2Id = {{addVocabExample2.response.body.data.id}}


### 7.2.4) Cập nhật ví dụ thứ 2 → set primary
###   Lưu ý: DTO yêu cầu @NotBlank exampleJp + exampleVi. Phải gửi lại các field bắt buộc.
PUT {{baseUrl}}/lesson-vocabulary-items/examples/{{vocabExample2Id}}
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "exampleJp": "学生は毎日勉強します。",
  "exampleVi": "Học sinh học mỗi ngày.",
  "isPrimary": true
}


### 7.2.5) Cập nhật từ vựng (xoá customMeaning bằng cách gửi rỗng)
PUT {{baseUrl}}/lesson-vocabulary-items/{{vocabItem1Id}}
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "customMeaning": "",
  "imageUrl": ""
}


### 7.2.6) (EXPECTED 400) Thêm ví dụ thiếu exampleJp
POST {{baseUrl}}/lesson-vocabulary-items/{{vocabItem1Id}}/examples
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "exampleVi": "Thiếu JP"
}


### 7.2.7) Xoá ví dụ
DELETE {{baseUrl}}/lesson-vocabulary-items/examples/{{vocabExample2Id}}
Authorization: Bearer {{teacherToken}}


### 7.2.8) Xoá từ vựng
DELETE {{baseUrl}}/lesson-vocabulary-items/{{vocabItem1Id}}
Authorization: Bearer {{teacherToken}}


### ============================================================
### 7.3) GRAMMAR SECTION — Items + Examples
### ============================================================

### 7.3.1) Thêm 1 điểm ngữ pháp vào section GRAMMAR
# @name addGrammar1
POST {{baseUrl}}/lesson-sections/{{grammarSectionId}}/grammar-items
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "grammarId": 1,
  "orderIndex": 1,
  "customMeaning": "Là (lịch sự)",
  "customStructure": "A は B です",
  "note": "Ngữ pháp cơ bản nhất"
}

###
@grammarItem1Id = {{addGrammar1.response.body.data.id}}


### 7.3.2) Thêm ví dụ cho ngữ pháp
# @name addGrammarExample1
POST {{baseUrl}}/lesson-grammar-items/{{grammarItem1Id}}/examples
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "exampleJp": "私は先生です。",
  "exampleVi": "Tôi là giáo viên.",
  "orderIndex": 1
}

###
@grammarExample1Id = {{addGrammarExample1.response.body.data.id}}


### 7.3.3) Cập nhật ngữ pháp
PUT {{baseUrl}}/lesson-grammar-items/{{grammarItem1Id}}
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "note": "Đã cập nhật ghi chú"
}


### 7.3.4) Cập nhật ví dụ ngữ pháp
###   Lưu ý: DTO yêu cầu @NotBlank exampleJp + exampleVi.
PUT {{baseUrl}}/lesson-grammar-items/examples/{{grammarExample1Id}}
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "exampleJp": "私は先生です。",
  "exampleVi": "Tôi là giáo viên (đã cập nhật)."
}


### 7.3.5) (EXPECTED 400) Thêm ngữ pháp thiếu grammarId
POST {{baseUrl}}/lesson-sections/{{grammarSectionId}}/grammar-items
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "note": "Thiếu grammarId"
}


### 7.3.6) Xoá ví dụ ngữ pháp
DELETE {{baseUrl}}/lesson-grammar-items/examples/{{grammarExample1Id}}
Authorization: Bearer {{teacherToken}}


### 7.3.7) Xoá ngữ pháp
DELETE {{baseUrl}}/lesson-grammar-items/{{grammarItem1Id}}
Authorization: Bearer {{teacherToken}}


### ============================================================
### 7.4) VERIFY — Xem lại lesson đầy đủ
### ============================================================
GET {{baseUrl}}/lessons/{{lessonId}}
Authorization: Bearer {{studentToken}}
