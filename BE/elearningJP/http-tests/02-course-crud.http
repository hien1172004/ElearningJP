### Variables (chạy 01-auth.http trước)
@baseUrl = http://localhost:8080/api/v1
@teacherToken = {{teacherLogin.response.body.data.accessToken}}
@studentToken = {{studentLogin.response.body.data.accessToken}}

### ============================================================
### 2.1) TEACHER tạo course (lưu id để dùng cho các test sau)
###   → Sau refactor V15: TEACHER được phép tạo course.
###   → createdBy = teacher, course sẽ gắn với teacher.
### ============================================================
# @name createCourseN5
POST {{baseUrl}}/courses
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "title": "JLPT N5 Cơ Bản",
  "slug": "jlpt-n5-co-ban",
  "jlptLevel": "N5",
  "description": "Khóa học NJLPT N5 dành cho người mới bắt đầu",
  "thumbnailUrl": "https://example.com/n5.jpg",
  "published": false
}

###
@courseId = {{createCourseN5.response.body.data.id}}

### ============================================================
### 2.2) TEACHER tạo course thứ 2 (cho test list/filter)
### ============================================================
POST {{baseUrl}}/courses
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "title": "JLPT N4 Trung Cấp",
  "slug": "jlpt-n4-trung-cap",
  "jlptLevel": "N4",
  "description": "Khóa học N4",
  "published": false
}

### ============================================================
### 2.3) (EXPECTED 409) Tạo course với slug đã tồn tại
### ============================================================
POST {{baseUrl}}/courses
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "title": "Trùng slug",
  "slug": "jlpt-n5-co-ban",
  "jlptLevel": "N5",
  "published": false
}

### ============================================================
### 2.4) (EXPECTED 403) STUDENT tạo course - không đủ quyền
###   → Chỉ ADMIN hoặc TEACHER mới được tạo.
### ============================================================
POST {{baseUrl}}/courses
Content-Type: application/json
Authorization: Bearer {{studentToken}}

{
  "title": "Học sinh tạo course",
  "slug": "student-course",
  "jlptLevel": "N5",
  "published": false
}

### ============================================================
### 2.5) GET course detail (public, course chưa publish)
### ============================================================
GET {{baseUrl}}/courses/{{courseId}}

### ============================================================
### 2.6) GET course theo slug (public)
### ============================================================
GET {{baseUrl}}/courses/slug/jlpt-n5-co-ban

### ============================================================
### 2.7) GET list course đã publish (public) - ban đầu sẽ rỗng
### ============================================================
GET {{baseUrl}}/courses

### ============================================================
### 2.8) GET course theo level N5 (public)
### ============================================================
GET {{baseUrl}}/courses/level/N5

### ============================================================
### 2.9) TEACHER update course CỦA MÌNH → OK
###   Lưu ý: CourseUpdateRequest yêu cầu @NotBlank title + @NotNull jlptLevel
###   → phải gửi đủ, không thể chỉ patch description.
### ============================================================
PUT {{baseUrl}}/courses/{{courseId}}
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "title": "JLPT N5 Cơ Bản",
  "jlptLevel": "N5",
  "description": "Đã cập nhật mô tả mới",
  "published": false
}

### ============================================================
### 2.10) TEACHER publish course CỦA MÌNH → OK
### ============================================================
PATCH {{baseUrl}}/courses/{{courseId}}/publish?publish=true
Authorization: Bearer {{teacherToken}}

### ============================================================
### 2.11) GET list course đã publish - giờ phải có
### ============================================================
GET {{baseUrl}}/courses

### ============================================================
### 2.11a) GET list với pagination cơ bản
###   Lưu ý: backend dùng page **1-indexed** (mặc định page=1, size=10)
###   → page=0 cũng OK vì service tự Math.max(0, page-1) = 0
###   Sort được hardcode = createdAt DESC trong CourseService, không nhận param.
### ============================================================
GET {{baseUrl}}/courses?page=0&size=10

### ============================================================
### 2.11b) GET list trang 2 (page=2 theo 1-indexed)
###   Nếu tổng < 20 record, trang này sẽ rỗng.
### ============================================================
GET {{baseUrl}}/courses?page=2&size=10

### ============================================================
### 2.11c) GET list trang 1, size lớn (lấy hết)
### ============================================================
GET {{baseUrl}}/courses?page=1&size=20

### ============================================================
### 2.11d) GET trang 1 với size nhỏ (5 phần tử)
### ============================================================
GET {{baseUrl}}/courses?page=1&size=5

### ============================================================
### 2.11e) Filter theo JLPT level N5 (chỉ trang public mới có filter này)
### ============================================================
GET {{baseUrl}}/courses?page=1&size=10&jlptLevel=N5

### ============================================================
### 2.12) (EXPECTED 403) STUDENT gọi /admin (admin-only)
### ============================================================
GET {{baseUrl}}/courses/admin
Authorization: Bearer {{studentToken}}

### ============================================================
### 2.12a) TEACHER gọi /admin → 403 (chỉ ADMIN được xem tất cả)
### ============================================================
GET {{baseUrl}}/courses/admin
Authorization: Bearer {{teacherToken}}

### ============================================================
### 2.13) TEACHER unpublish course CỦA MÌNH
### ============================================================
PATCH {{baseUrl}}/courses/{{courseId}}/publish?publish=false
Authorization: Bearer {{teacherToken}}

### ============================================================
### 2.14) (EXPECTED 403) TEACHER update course CỦA TEACHER KHÁC
###   → Yêu cầu: tạo 1 teacher khác trước, tạo course bằng teacher2,
###     rồi dùng teacher1 update → phải 403 FORBIDDEN_COURSE_ACCESS
### ============================================================
# (Xem file 09-course-ownership-test.http để test kỹ case này)

### ============================================================
### 2.15) TEACHER delete (soft) course CỦA MÌNH
### ============================================================
DELETE {{baseUrl}}/courses/{{courseId}}
Authorization: Bearer {{teacherToken}}

### ============================================================
### 2.16) (EXPECTED 404) GET course đã xoá
### ============================================================
GET {{baseUrl}}/courses/{{courseId}}
